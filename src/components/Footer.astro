---
const { title, description } = Astro.props
const year = new Date().getFullYear()
---

<footer id="footer" class="panel">
  <div class="inner split">
    <div>
      <section>
        <h2>{title}</h2>
        <p>{description}</p>
        <p>Film photographs by Mitchell Parker. Japan / Australia.</p>
      </section>
      <section>
        <h2>Follow me on ...</h2>
        <ul class="icons">
          <li>
            <a
              href="https://www.instagram.com/mitch.aiff/"
              class="icon brands fa-instagram"
              aria-label="Instagram"
            >
              <span class="label">Instagram</span>
            </a>
          </li>
          <li>
            <a
              href="https://x.com/mitchparker99"
              class="icon brands fa-twitter"
              aria-label="X"
            >
              <span class="label">X</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/mitchparker99"
              class="icon brands fa-github"
              aria-label="GitHub"
            >
              <span class="label">GitHub</span>
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/mitchparker99/"
              class="icon brands fa-linkedin-in"
              aria-label="LinkedIn"
            >
              <span class="label">LinkedIn</span>
            </a>
          </li>
        </ul>
      </section>
      <p class="copyright">
        &copy; {year} Mitchell Parker. All photographs are my own.<br />
      </p>
    </div>
    <div>
      <section>
        <h2>Get in touch</h2>
        <p>
          Questions about a photograph, or just want to say hello? Send me an
          email.
        </p>
        <ul class="actions">
          <li>
            <a
              href="mailto:mitchelljamesparker99@gmail.com"
              class="button primary">Email me</a
            >
          </li>
        </ul>
      </section>
    </div>
  </div>
</footer>
