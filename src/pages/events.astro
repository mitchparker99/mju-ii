---
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import GalleryEvents from '@/components/GalleryEvents.astro'
import ExternalScripts from '@/components/ExternalScripts.astro'

// Visible on the page
let heading = 'EVENTS'
let caption = 'SHOT WITH OLYMPUS MJU-II [DELUXE]'

// Document metadata
let title = 'Events — Mitchell Parker Film Photography'
let description =
  'Events shot on film by Mitchell Parker with an Olympus mju-II [Deluxe].'
---

<!doctype html>
<html lang="en">
  <BaseHead
    title={title}
    description={description}
    author={'Mitchell Parker'}
    og={'/og-image.jpg'}
  />

  <body class="is-preload">
    <Header title={heading} />
    <Footer title={heading} description={caption} />
    <GalleryEvents title={heading} description={caption} />
    <ExternalScripts />
  </body>
</html>
