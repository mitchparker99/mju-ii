---
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import GalleryBandw from '@/components/GalleryBandw.astro'
import ExternalScripts from '@/components/ExternalScripts.astro'

// Visible on the page
let heading = 'B & W'
let caption = 'SHOT WITH OLYMPUS MJU-II [DELUXE]'

// Document metadata
let title = 'Black & White — Mitchell Parker Film Photography'
let description =
  'Black and white film photographs by Mitchell Parker, shot on an Olympus mju-II [Deluxe].'
---

<!doctype html>
<html lang="en">
  <BaseHead
    title={title}
    description={description}
    author={'Mitchell Parker'}
    og={'/og-image.jpg'}
  />

  <body class="is-preload">
    <Header title={heading} />
    <Footer title={heading} description={caption} />
    <GalleryBandw title={heading} description={caption} />
    <ExternalScripts />
  </body>
</html>
