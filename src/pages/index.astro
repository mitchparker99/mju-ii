---
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import Gallery from '@/components/Gallery.astro'
import ExternalScripts from '@/components/ExternalScripts.astro'

// Visible on the page
let heading = 'GALLERY'
let caption = 'SHOT WITH OLYMPUS MJU-II [DELUXE]'

// Document metadata
let title = 'Mitchell Parker — Film Photography on an Olympus mju-II'
let description =
  'Film photographs by Mitchell Parker, shot on an Olympus mju-II [Deluxe].'
---

<!doctype html>
<html lang="en">
  <BaseHead
    title={title}
    description={description}
    author={'Mitchell Parker'}
    og={'/og-image.jpg'}
  />

  <body class="is-preload">
    <Header title={heading} />
    <Footer title={heading} description={caption} />
    <Gallery title={heading} description={caption} />
    <ExternalScripts />
  </body>
</html>
